# DevSpace Ultra Gateway Configuration
PORT=4000
GATEWAY_HOST=0.0.0.0
STORAGE_DIR=.devspace-storage

# Master Secret for Admin / Token Generation
MASTER_SECRET=devspace-ultra-secure-master-secret-replace-in-production

# Kaggle API Credentials (Optional on Gateway if submitted by Client or Configured on Agent/Kaggle Runner)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Local Agent Outbound Connection
GATEWAY_URL=http://localhost:4000
AGENT_ID=desktop-windows-primary
AGENT_TOKEN=
